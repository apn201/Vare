# Copy to .env and fill in. .env is git-ignored; real env vars take precedence.

# Qloo hackathon key (hackathon keys only work on the hackathon base URL).
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Any OpenAI-compatible chat endpoint. Same model runs baseline and Qloo path.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Private server-side cache of Qloo responses (allowed by the hackathon terms).
# Keeps us inside 5 req/s and 10,000 req/month. Empty value disables it.
QLOO_CACHE_PATH=var/qloo_cache.db

# Set true in dev to persist traces to SQLite (var/traces.db).
DEBUG_RETAIN_TRACES=false

# MCP endpoint (/mcp): public hostnames allowed in the Host header, comma-separated.
# Localhost is always allowed. Needed when Apache preserves the public Host
# (subdomain setup), e.g. MCP_ALLOWED_HOSTS=vare.helppox.com
MCP_ALLOWED_HOSTS=

# Per-visitor limits (the demo has no login). Runs = web comparisons and MCP
# create_tags / suggest_topics; lookups = MCP qloo_profile / qloo_related.
# 0 disables a limit.
VARE_RUNS_PER_10MIN=10
VARE_RUNS_PER_DAY=60
VARE_LOOKUPS_PER_10MIN=30
VARE_RUNS_PER_DAY_TOTAL=400

# Stop calling Qloo when this few monthly calls remain (Qloo reports the
# remaining quota on every response), so the key lasts through judging.
QLOO_MONTH_RESERVE=300
